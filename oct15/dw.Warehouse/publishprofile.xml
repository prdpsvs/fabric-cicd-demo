<Project>
  <PropertyGroup>
    <BlockOnPossibleDataLoss>True</BlockOnPossibleDataLoss>
    <DropObjectsNotInSource>False</DropObjectsNotInSource>
    <VerifyDeployment>True</VerifyDeployment>
    <TreatVerificationErrorsAsWarnings>False</TreatVerificationErrorsAsWarnings>
    <GenerateSmartDefaults>True</GenerateSmartDefaults>
    <AllowTableRecreation>True</AllowTableRecreation>
    <DoNotDropObjectTypes>DatabaseRoles;ExternalDataSources;ExternalTables;ScalarValuedFunctions;StoredProcedures;Tables;TableValuedFunctions;Views</DoNotDropObjectTypes>
  </PropertyGroup>
</Project>